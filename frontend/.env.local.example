# Copy to .env.local and fill in. Never commit .env.local.

# ── Backend ──────────────────────────────────────────────────────────────────
# The Harmoniq API origin. In production this must be the deployed backend URL
# with no trailing slash, and the frontend's own origin must be listed in the
# backend's CORS_ALLOWED_ORIGINS or every browser request will fail.
#
# NEXT_PUBLIC_* values are inlined at build time — changing this requires a
# new build, not just a redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Clerk auth ───────────────────────────────────────────────────────────────
# From the Clerk dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Note: NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL / ..._AFTER_SIGN_UP_URL are ignored
# by @clerk/nextjs 7 — superseded by ..._FALLBACK_REDIRECT_URL. The default is
# "/", which is what we want, so neither needs setting.
